<script language='javascript'>
<!--
//↓쿠키저장 함수
function setCookie(name,value,expiredays){ 
	var todayDate = new Date(); 
	todayDate.setDate( todayDate.getDate() + expiredays ); 
	document.cookie = name + "=" + escape( value ) + "; path=/; expires=" + todayDate.toGMTString() + ";" 
}
//↓창닫기 함수
function frame_cLOSe(){
	parent.close()
	window.close()
	self.close()
}
//[cLOSe]버튼클릭시 적용 함수
function cLOSe_win(){ 
	if (document.all.<?=$Cni_pop?>.checked)
		setCookie("<?=$Cni_pop?>","none",1);	//체크시 적용 = 쿠키저장 함수 호출
	frame_cLOSe();	//창닫기 함수 호출
} 

function kk(){
	var target="<?=$P_Target?>";
	if(target=="_blank"){
		var newWin = window.open('about:blank');
		newWin.location.href="<?=$P_Link?>";
	}else if(target=="_parent"){
		opener.parent.location.href="<?=$P_Link?>";
	}else if(target=="_self"){
		opener.self.location.href="<?=$P_Link?>";
	}else if(target=="_top"){
		opener.top.location.href="<?=$P_Link?>";
	}
	window.close();
}
//-->
</script>
